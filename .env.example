# ============================================
# TÍO TITO — Configuración GRATIS
# ============================================
# Modo laptop: ver docs/laptop-local.md
# En n8n (VPS) agregar variable: CEREBRO_URL

# === Base de datos (local en laptop, SQLite) ===
DATABASE_URL=sqlite:///data/tiotito.db

# === Evolution API (en tu VPS) ===
EVOLUTION_URL=https://tu-vps:8080
EVOLUTION_API_KEY=tu_api_key_evolution
EVOLUTION_INSTANCE=tio-tito

# === n8n (en tu VPS) ===
N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/tio-tito-mensajes

# === Grupo WhatsApp ===
GRUPO_JID=120363123456789012@g.us
RESPONDER_PRIVADO=true

# === IA — elegí UNO ===

# OPCIÓN 1: Groq (RECOMENDADO — gratis, buena calidad, 0 RAM local)
# Crear key en: https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_tu_key_aqui
GROQ_MODEL=qwen/qwen3.6-27b

# OPCIÓN 2: Ollama local (100% gratis, corre en tu laptop)
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:0.5b

# OPCIÓN 3: OpenAI (de pago, descomentar si querés)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# === Comportamiento ===
CEREBRO_PORT=8000
CONTEXTO_MENSAJES=40
MENSAJES_AUTO_INTERVALO_MIN=60
MENSAJES_AUTO_PROBABILIDAD=0.5
MAX_RESPUESTAS_DIA=20

# Ollama (solo si LLM_PROVIDER=ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_TIMEOUT=300
# OLLAMA_CONTEXTO_MENSAJES=15
